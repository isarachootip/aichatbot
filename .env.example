# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# PostgreSQL (Docker Compose; host port defaults to 5439 to avoid clashing with local Postgres)
POSTGRES_HOST_PORT=5439
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=chatbot
APP_DB_USER=app_user
APP_DB_PASSWORD=app_dev_password

# Database URLs (app_user enforces RLS; postgres runs Alembic migrations)
DATABASE_URL=postgresql+asyncpg://app_user:app_dev_password@postgres:5432/chatbot
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/chatbot
TEST_DATABASE_URL=postgresql+asyncpg://app_user:app_dev_password@postgres:5432/chatbot_test
TEST_DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/chatbot_test

# Redis / ARQ (host port defaults to 6380 to avoid clashing with local Redis)
REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379/0

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET=knowledge-base

# Embeddings (locked to 1024 dimensions across providers)
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001
LLM_ESCALATION_MODEL=claude-sonnet-4-5-20250929
LLM_ESCALATION_ENABLED=false

# Security & Auth
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_BASE64_FERNET_KEY
SUPABASE_URL=
SUPABASE_JWKS_URL=
DEV_JWT_SECRET=dev-only-change-me-in-production

# Payments (Omise)
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
